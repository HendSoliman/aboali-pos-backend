# arabic-pos-backend/.env
# ── PostgreSQL ──────────────────────────────────
POSTGRES_DB=aboali_pos
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=pos_pass_1234

# ── pgAdmin ─────────────────────────────────────
# ✅ Fixed: key names now match docker-compose PGADMIN_DEFAULT_* keys
PGADMIN_DEFAULT_EMAIL=admin@aboalipos.com
PGADMIN_DEFAULT_PASSWORD=admin_123


# ── Spring Boot (used in application.properties) ─
DB_URL=jdbc:postgresql://localhost:5432/aboali_pos
DB_USERNAME=pos_user
DB_PASSWORD=pos_pass_1234
